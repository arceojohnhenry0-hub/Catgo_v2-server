<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#10131a">
<meta name="description" content="CatGO - catch cats in the real world">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon.svg">
<title>CatGO — Catch Cats Everywhere</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<div id="app">
  <header class="topbar">
    <div class="brand"><span class="brand-icon">🐾</span><div><b>CAT<span>GO</span></b><small>GO OUT. FIND CATS.</small></div></div>
    <div class="stats"><div><span>⭐</span><b id="level">1</b></div><div><span>🪙</span><b id="coins">100</b></div><div><span>🍗</span><b id="treats">10</b></div></div>
  </header>

  <main>
    <section id="mapView" class="view active">
      <div id="map"></div>
      <div class="map-gradient"></div>
      <div class="map-actions">
        <button class="round-btn" id="locateBtn" title="Locate me">⌖</button>
        <button class="round-btn" id="scanBtn" title="Scan">📡</button>
      </div>
      <div class="nearby-card">
        <div class="nearby-title"><span>NEARBY CATS</span><b id="nearbyCount">0</b></div>
        <div id="nearbyList" class="nearby-list"></div>
      </div>
      <div id="gpsNotice" class="notice">📍 Allow location access to start finding cats.</div>
    </section>

    <section id="collectionView" class="view">
      <div class="page-head"><div><small>YOUR COLLECTION</small><h1>Cat Gallery</h1></div><div class="dex-count"><b id="uniqueCount">0</b>/12</div></div>
      <div class="gallery-tabs">
        <button class="gallery-tab active" data-gallery="mythical">✨ MYTHICAL</button>
        <button class="gallery-tab" data-gallery="real">📷 REAL CATS</button>
      </div>
      <div id="gallery" class="gallery"></div>
      <div id="realGallery" class="gallery hidden-gallery"></div>
    </section>

    <section id="cameraView" class="view">
      <div class="camera-head"><small>REAL-WORLD COLLECTION</small><h1>Cat Camera</h1><p>Photograph a real living cat to add it to your Real Cats gallery.</p></div>
      <div class="camera-frame">
        <video id="cameraVideo" autoplay playsinline muted></video>
        <canvas id="cameraCanvas"></canvas>
        <div class="camera-guide">🐱</div>
        <div id="cameraStatus" class="camera-status">Camera ready</div>
      </div>
      <div class="camera-controls">
        <button id="startCamera" class="secondary">📷 START CAMERA</button>
        <button id="captureCat" class="camera-shutter" disabled>●</button>
        <label class="secondary upload-btn">🖼️ USE PHOTO<input id="photoInput" type="file" accept="image/*" capture="environment" hidden></label>
      </div>
      <p class="camera-tip">Only use this feature to photograph cats you can safely see. Never chase, grab, trap, or disturb a real animal for the game.</p>
    </section>

    <section id="profileView" class="view">
      <div class="profile-hero">
        <div class="avatar">🐱</div><div><small>CAT TRAINER</small><h1>Cat Explorer</h1><p id="profileLevel">Level 1 · 0 XP</p></div>
      </div>
      <div class="progress"><div id="xpBar"></div></div>
      <div class="profile-grid">
        <div class="metric"><b id="caughtTotal">0</b><span>CATS CAUGHT</span></div>
        <div class="metric"><b id="streak">0</b><span>DAY STREAK</span></div>
        <div class="metric"><b id="uniqueProfile">0</b><span>SPECIES</span></div>
      </div>
      <div class="card">
        <h3>🎁 Daily Scout Bonus</h3><p>Claim daily rewards to keep your streak alive.</p>
        <button class="primary full" id="dailyBtn">CLAIM DAILY BONUS</button>
      </div>
      <div class="card">
        <h3>🍗 Treat Shop</h3><p>5 coins = 1 treat</p><button class="secondary full" id="buyBtn">BUY 5 TREATS · 25 🪙</button>
      </div>
    </section>
  </main>

  <nav class="bottom-nav">
    <button class="nav active" data-view="mapView"><span>🗺️</span><small>HUNT</small></button>
    <button class="nav" data-view="collectionView"><span>📖</span><small>GALLERY</small></button>
    <button class="nav" data-view="cameraView"><span>📷</span><small>REAL CATS</small></button>
    <button class="nav" data-view="profileView"><span>👤</span><small>PROFILE</small></button>
  </nav>
</div>

<div id="catchModal" class="modal hidden">
  <div class="modal-backdrop"></div>
  <div class="catch-sheet">
    <button class="close" id="closeCatch">×</button>
    <div id="catScene" class="cat-scene"><div id="catEmoji">🐱</div></div>
    <div class="catch-info"><span id="catRarity" class="pill">COMMON</span><h2 id="catName">Marmalade</h2><p id="catFlavor">A curious cat appeared nearby.</p></div>
    <div class="timing"><div class="timing-ring"><div id="targetRing"></div><div id="timingDot"></div></div><p id="timingText">Tap CATCH when the dot is inside the ring!</p></div>
    <button id="catchBtn" class="catch-button">🐾 CATCH!</button>
  </div>
</div>

<div id="resultModal" class="modal hidden">
 <div class="result-sheet"><div id="resultEmoji">😻</div><div class="confetti">✦ ✧ ✦</div><h2 id="resultTitle">Gotcha!</h2><p id="resultText">You caught a cat.</p><div class="result-stats"><span>⭐ <b id="resultXp">+20 XP</b></span><span>🪙 <b id="resultCoins">+5</b></span></div><button id="continueBtn" class="primary full">CONTINUE HUNT</button></div>
</div>

<div id="toast" class="toast"></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/app.js"></script>
</body>
</html>
